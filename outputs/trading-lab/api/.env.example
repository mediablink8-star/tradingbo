# Paper by default — never commit real keys
ENV=paper

# Alpaca paper (email signup, no full KYC)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional OANDA practice
# OANDA_API_KEY=
# OANDA_ACCOUNT_ID=

# Solana live only when ready
# SOLANA_PRIVATE_KEY=

# Risk for $100-style live wallet
MAX_PER_TRADE_USD=12
MAX_DAILY_LOSS_USD=25
MAX_OPEN_POSITIONS=2
MAX_EXPOSURE_USD=30
ARM_TTL_HOURS=24

# LLM
# LLM_API_KEY=
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-2-latest
